# PostgreSQL (Neon, Vercel Postgres, lokální Docker…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# NextAuth — https://authjs.dev (náhodný řetězec, min. 32 znaků)
AUTH_SECRET=

# Volitelně: první admin po `npm run db:seed` (jen pokud jsou obě proměnné vyplněné)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend — https://resend.com (API klíč a ověřená doména pro „from“)
RESEND_API_KEY=
# Odesílatel (musí být z ověřené domény, nebo onboarding@resend.dev v režimu vývoje)
RESEND_FROM_EMAIL="Naučíme.se <onboarding@resend.dev>"
# Kam dorazí poptávky z formuláře /doucovani
DOUCOVANI_TO_EMAIL=ty@example.com
